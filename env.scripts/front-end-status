#!/usr/bin/env bash
# front-end-status — mostra onde o app pode rodar e se ele está aberto.
#
# Uso: env.scripts/front-end-status
#
# Lista os aparelhos Android conectados e os simuladores iOS ligados, diz se o
# app está instalado e aberto em cada um e se há daemons do Gradle ocupando
# memória. Só lê: não liga nem desliga nada. Sai com 0 se o app estiver aberto
# em pelo menos um aparelho.

source "$(dirname "$0")/lib.sh"
help_if_asked "${1:-}"

running=0

devices="$(android_devices)"
if [ -z "$devices" ]; then
  printf 'Android: nenhum aparelho conectado\n'
else
  for serial in $devices; do
    # "pm path" responde só se o app estiver instalado; "pidof" só se aberto.
    state="não instalado"
    if "$ADB" -s "$serial" shell pm path "$APP_ID" >/dev/null 2>&1; then
      state="instalado, fechado"
      if [ -n "$("$ADB" -s "$serial" shell pidof "$APP_ID" 2>/dev/null | tr -d '\r')" ]; then
        state="aberto"
        running=1
      fi
    fi
    printf 'Android %s: app %s\n' "$serial" "$state"
  done
fi

sims="$(booted_simulators)"
if [ -z "$sims" ]; then
  printf 'iOS: nenhum simulador ligado\n'
else
  for udid in $sims; do
    state="não instalado"
    if xcrun simctl get_app_container "$udid" "$APP_ID" >/dev/null 2>&1; then
      state="instalado"
      # O launchd do simulador lista os processos com o bundle id no rótulo.
      # grep sem -q: o -q para no primeiro achado e fecha o cano antes de o
      # launchctl terminar de escrever (o mesmo SIGPIPE explicado no lib.sh).
      if xcrun simctl spawn "$udid" launchctl list 2>/dev/null | grep "$APP_ID" >/dev/null; then
        state="aberto"
        running=1
      fi
    fi
    printf 'iOS %s: app %s\n' "$udid" "$state"
  done
fi

printf 'Gradle do app: %s daemon(s) rodando\n' "$(app_gradle_daemons)"

[ "$running" = 1 ]
